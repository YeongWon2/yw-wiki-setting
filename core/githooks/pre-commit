#!/bin/sh
# LLM 위키 pre-commit: tools/check.py (frontmatter · 템플릿 · 링크 · raw 불변 · index 최신).
# Python은 3.14 이상(보안 지원 버전). Obsidian 앱처럼 PATH가 짧은 곳에서도 찾도록 Homebrew 경로까지 본다.
PY=$(command -v python3.15 || command -v python3.14 || ls /opt/homebrew/bin/python3.14 /usr/local/bin/python3.14 2>/dev/null | head -1)
[ -n "$PY" ] || { echo "Python 3.14가 없다 — brew install python@3.14"; exit 1; }
exec "$PY" tools/check.py
