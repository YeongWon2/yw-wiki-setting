#!/bin/sh
# LLM 위키 pre-commit: yw-wiki check (frontmatter · 템플릿 · 링크 · raw 불변 · index 최신).
# Obsidian 앱처럼 PATH가 짧은 곳에서도 찾도록 ~/.local/bin · ~/.cargo/bin까지 본다.
B=$(command -v yw-wiki || ls "$HOME/.local/bin/yw-wiki" "$HOME/.cargo/bin/yw-wiki" 2>/dev/null | head -1)
[ -n "$B" ] || { echo "yw-wiki가 없다 — brew install rust 뒤 sh <yw-wiki-setting>/install.sh"; exit 1; }
exec "$B" check
