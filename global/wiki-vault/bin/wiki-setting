#!/usr/bin/env python3.14
"""wiki-setting: 이 PC의 LLM 위키 볼트를 관리한다. 볼트 목록은 ~/.config/wiki/vaults.toml (PC마다 하나, git에 올리지 않음).

  wiki-setting install [--from <세팅 폴더>] [--dry-run]   전역 길잡이 스킬을 Claude Code · Codex에 복사, vaults.toml이 없으면 만든다
  wiki-setting list | path <id>                          등록된 볼트와 경로
  wiki-setting register <폴더> [--id <id>] [--readonly] [--name <이름>] [--alias <별칭>]... [--description <설명>]
                                                         볼트 등록 (id는 그 폴더 wiki.toml [wiki] id). 이름 · 별칭 · 설명을 주면
                                                         vaults.toml에 두고 wiki.toml 값보다 먼저 쓴다 (wiki.toml이 없는 노트 폴더용)
  wiki-setting new-vault --profile personal --path <폴더>   위키 생성 + 등록 + 첫 점검
  wiki-setting doctor [--fix]                            전역 스킬 · 목록 · 경로 · 세팅 버전 · 각 볼트 점검 (--fix: 옮겨진 볼트 경로와 그 Obsidian 볼트 고침)
  wiki-setting upgrade [<id>] [--yes]                    세팅 최신 릴리스 태그를 받아 볼트에 반영 (메이저는 --yes)
  wiki-setting check [--vault <폴더>]                    최신 확인: 세팅 사본 → main의 최신 릴리스 태그, 전역 스킬 버전,
                                                         볼트 세팅 버전(패치 · 마이너는 반영 · 커밋, 메이저는 알림), 볼트 main 기준
  wiki-setting obsidian [--fix] [--prune] [--restart]    Obsidian 볼트 목록을 위키 경로에 맞춘다: 옮기거나 이름을 바꾼 위키의 볼트 경로,
                                                         없어진 폴더를 가리키는 볼트 설정(새 노트 · 첨부 · 템플릿 · 일지 폴더).
                                                         --fix로 고친다(Obsidian이 꺼져 있을 때만). --prune: 폴더가 없는 볼트 항목을 지운다.
                                                         --restart: 고칠 것이 있으면 켜진 Obsidian을 정상 종료 → 고침 → 다시 켬
                                                         (사람에게 "Obsidian을 끌까요?" 물은 뒤에만 쓴다)

세팅(yw-wiki-setting)은 vaults.toml [setting] path의 git 사본을 쓴다. 원격이 있으면 main이 아니라 최신 릴리스 태그(vX.Y.Z)를 받는다.
원격에 접속할 수 없으면 가진 사본으로 계속하고 doctor가 알린다.
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

if sys.version_info < (3, 14):
    sys.exit(f"Python 3.14 이상이 필요하다 (지금 {sys.version.split()[0]}). brew install python@3.14")

import tomllib

HOME = Path.home()
VAULTS = HOME / ".config" / "wiki" / "vaults.toml"
SKILL_DIRS = [HOME / ".claude" / "skills" / "wiki-vault", HOME / ".agents" / "skills" / "wiki-vault"]
SEARCH_ROOTS = [HOME / "Desktop" / "wiki", HOME / "vaults", HOME / "Desktop", HOME / "Documents", HOME / "Desktop" / "yw-workspace"]
DEFAULT_SETTING = HOME / "Desktop" / "wiki" / "yw-wiki-setting"
PY = sys.executable
VAULT_META = ("name", "description", "aliases")  # vaults.toml에 두면 wiki.toml [wiki] 값보다 먼저 쓴다
# Obsidian 볼트 설정 중 폴더를 가리키는 값. 폴더 구조가 바뀌면 세팅 값(core/obsidian)으로 맞춘다
OBSIDIAN_FOLDERS = {"app.json": ("newFileFolderPath", "attachmentFolderPath"), "templates.json": ("folder",), "daily-notes.json": ("folder",)}


def load():
    return tomllib.loads(VAULTS.read_text()) if VAULTS.exists() else {"version": 1, "vaults": {}}


def dump(conf):
    lines = ["# 이 PC의 LLM 위키 볼트 목록. wiki-setting이 관리한다. 이름 · 별칭 · 설명은 각 위키 wiki.toml, 여기 적으면 여기 값이 먼저.",
             f"version = {conf.get('version', 1)}"]
    if conf.get("default"):
        lines.append(f'default = "{conf["default"]}"')
    s = conf.get("setting", {})
    if s:
        lines += ["", "[setting]"] + [f'{k} = "{v}"' for k, v in s.items()]
    for vid, v in conf.get("vaults", {}).items():
        lines += ["", f"[vaults.{vid}]", f'path = "{v["path"]}"'] + (["readonly = true"] if v.get("readonly") else [])
        if v.get("obsidian_id"):  # 이 PC의 Obsidian 볼트 id. 위키 폴더가 옮겨져도 같은 볼트를 따라간다
            lines.append(f'obsidian_id = "{v["obsidian_id"]}"')
        for k in VAULT_META:
            if v.get(k):
                val = v[k]
                lines.append(f"{k} = [{', '.join(json.dumps(x, ensure_ascii=False) for x in val)}]" if isinstance(val, list)
                             else f"{k} = {json.dumps(val, ensure_ascii=False)}")
    return "\n".join(lines) + "\n"


def save(conf, dry):
    text = dump(conf)
    if dry:
        print(f"--- {VAULTS} (미리보기)\n{text}")
        return
    VAULTS.parent.mkdir(parents=True, exist_ok=True)
    VAULTS.write_text(text)
    print(f"저장: {VAULTS}")


def expand(p):
    return Path(os.path.expanduser(p)).resolve()


def short(p):
    p = str(p)
    return "~" + p[len(str(HOME)):] if p.startswith(str(HOME)) else p


def wiki_info(path):
    f = path / "wiki.toml"
    return tomllib.loads(f.read_text()).get("wiki", {}) if f.exists() else {}


def vault_info(v, path):
    """wiki.toml [wiki] 위에 vaults.toml 항목의 이름 · 별칭 · 설명을 덮는다."""
    return {**wiki_info(path), **{k: v[k] for k in VAULT_META if v.get(k)}}


def setting_dir(conf):
    return expand(conf.get("setting", {}).get("path", str(DEFAULT_SETTING)))


def git(*args, cwd):
    return subprocess.run(["git", "-C", str(cwd), *args], capture_output=True, text=True)


def latest_tag(sdir):
    """원격이 있으면 태그를 받아 origin/main에 있는 최신 vX.Y.Z를 돌려준다. (태그, 메모)"""
    if not git("remote", cwd=sdir).stdout.strip():
        return None, "원격 없음 — 로컬 사본 그대로 씀"
    if os.environ.get("YW_SETTING_CHECKED"):
        fetched = subprocess.CompletedProcess([], 0)
    else:
        fetched = git("fetch", "--tags", "--quiet", "origin", "+refs/heads/main:refs/remotes/origin/main", cwd=sdir)
    note = "" if fetched.returncode == 0 else "원격에 접속 못 함 — 가진 사본으로 계속"
    on_main = set(git("tag", "--merged", "origin/main", "--list", "v*", cwd=sdir).stdout.split())
    tags = [t for t in on_main if re.fullmatch(r"v\d+\.\d+\.\d+", t)]
    if not tags:
        return None, note or "릴리스 태그 없음 — 로컬 사본 그대로 씀"
    return max(tags, key=lambda t: tuple(map(int, t[1:].split(".")))), note


def obsidian_json():
    if sys.platform == "darwin":
        return HOME / "Library" / "Application Support" / "obsidian" / "obsidian.json"
    if os.name == "nt":
        return Path(os.environ.get("APPDATA", HOME)) / "obsidian" / "obsidian.json"
    return Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "obsidian" / "obsidian.json"


def obsidian_running():
    """Obsidian이 켜져 있으면 obsidian.json을 고쳐도 끌 때 덮어쓴다. (시험: YW_OBSIDIAN_RUNNING=0/1)"""
    if os.environ.get("YW_OBSIDIAN_RUNNING") in ("0", "1"):
        return os.environ["YW_OBSIDIAN_RUNNING"] == "1"
    try:
        return subprocess.run(["pgrep", "-xi", "obsidian"], capture_output=True).returncode == 0
    except FileNotFoundError:
        return False


def obsidian_quit():
    """켜진 Obsidian을 정상 종료하고 꺼질 때까지 기다린다(macOS). 시험에서는 YW_OBSIDIAN_RUNNING을 0으로 바꾼다."""
    if os.environ.get("YW_OBSIDIAN_RUNNING") == "1":
        os.environ["YW_OBSIDIAN_RUNNING"] = "0"
        return True
    if sys.platform != "darwin":
        return False
    subprocess.run(["osascript", "-e", 'quit app "Obsidian"'], capture_output=True)
    for _ in range(40):
        if not obsidian_running():
            return True
        time.sleep(0.5)
    return False


def obsidian_open():
    if "YW_OBSIDIAN_RUNNING" in os.environ:  # 시험
        return True
    return sys.platform == "darwin" and subprocess.run(["open", "-a", "Obsidian"], capture_output=True).returncode == 0


def obsidian_vaults(conf, fix, prune=False, hints=None):
    """위키마다 Obsidian 볼트를 찾아 경로를 맞춘다. (메모 목록, 문제 여부, vaults.toml을 고쳤나)
    찾는 순서: 기록한 obsidian_id → 같은 경로 → 상위 폴더 볼트(그대로 둠) → 폴더가 없어진 볼트 중
    이름이 같거나 hints(doctor가 고치기 전 경로)와 같은 것 하나."""
    oj = obsidian_json()
    if not oj.exists():
        return ["Obsidian 볼트 목록 없음 — 건너뜀"], False, False
    data = json.loads(oj.read_text())
    ovs = data.setdefault("vaults", {})
    gone = lambda o: not Path(o["path"]).exists()
    notes, bad, conf_changed, moves, used = [], False, False, [], set()
    for vid, v in conf.get("vaults", {}).items():
        path = expand(v["path"])
        if not path.exists():
            continue
        oid = v.get("obsidian_id") if v.get("obsidian_id") in ovs else None
        oid = oid or next((i for i, o in ovs.items() if Path(o["path"]) == path), None)
        if not oid:
            cover = next((i for i, o in ovs.items() if path.is_relative_to(Path(o["path"]))), None)
            if cover:
                used.add(cover)
                notes.append(f"{vid}: Obsidian은 상위 폴더 볼트 {short(ovs[cover]['path'])}로 엶")
                continue
            old = (hints or {}).get(vid)
            cands = [i for i, o in ovs.items() if gone(o) and (Path(o["path"]).name == path.name or Path(o["path"]) == old)]
            if len(cands) != 1:
                notes.append(f"{vid}: Obsidian 볼트 없음" + (f" — 후보 여럿({', '.join(short(ovs[i]['path']) for i in cands)}), 사람이 고른다"
                                                             if cands else " — Obsidian에서 이 폴더를 볼트로 열면 등록된다"))
                continue
            oid = cands[0]
        used.add(oid)
        if v.get("obsidian_id") != oid:
            v["obsidian_id"], conf_changed = oid, True
        if Path(ovs[oid]["path"]) != path:
            moves.append((vid, oid, ovs[oid]["path"], str(path)))
    stale = [i for i, o in ovs.items() if i not in used and gone(o)]
    todo = moves + (stale if prune else [])
    if todo and fix and obsidian_running():
        notes.append("Obsidian이 켜져 있어 볼트 목록을 고치지 않음 — 사람에게 끌지 묻고 --restart로 다시")
        return notes, True, conf_changed
    for vid, oid, old, new in moves:
        if fix:
            ovs[oid]["path"] = new
        notes.append(f"{vid}: Obsidian 볼트 {short(old)} → {short(new)}" + ("" if fix else " (옮길 것 — --fix)"))
        bad |= not fix
    for oid in stale:
        notes.append(f"폴더가 없는 Obsidian 볼트 {short(ovs[oid]['path'])}" + (" 지움" if fix and prune else " (지우려면 --fix --prune)"))
        bad |= prune and not fix
        if fix and prune:
            del ovs[oid]
    if fix and todo:
        shutil.copy2(oj, oj.with_name("obsidian.json.yw-bak"))  # 고치기 전 사본
        oj.write_text(json.dumps(data, ensure_ascii=False))
    return notes, bad, conf_changed


def obsidian_folders(conf, sdir, fix):
    """위키의 Obsidian 설정이 없는 폴더를 가리키면 세팅 값으로 맞춘다. (메모 목록, 문제 여부)"""
    notes, bad = [], False
    for vid, v in conf.get("vaults", {}).items():
        path = expand(v["path"])
        st = path / ".wiki-setting.toml"
        if v.get("readonly") or not st.exists():
            continue
        profile = tomllib.loads(st.read_text()).get("profile", "personal")
        for name, keys in OBSIDIAN_FOLDERS.items():
            f = path / ".obsidian" / name
            if not f.exists():
                continue
            conf_o = json.loads(f.read_text())
            src = next((p for p in (sdir / "core" / "obsidian" / profile / name, sdir / "core" / "obsidian" / "common" / name) if p.exists()), None)
            want = json.loads(src.read_text()) if src else {}
            changed = False
            for k in keys:
                cur = conf_o.get(k)
                if not cur or (path / cur).is_dir():
                    continue
                new = want.get(k)
                if new and (path / new).is_dir():
                    notes.append(f"{vid}: Obsidian {name} {k} {cur} → {new}" + ("" if fix else " (고칠 것 — --fix)"))
                    if fix:
                        conf_o[k], changed = new, True
                    bad |= not fix
                else:
                    notes.append(f"{vid}: Obsidian {name} {k}가 없는 폴더 {cur}를 가리킴 — 사람이 정한다")
                    bad = True
            if changed and obsidian_running():
                notes.append(f"{vid}: Obsidian이 켜져 있어 {name}을 고치지 않음 — 사람에게 끌지 묻고 --restart로 다시")
                bad = True
            elif changed:
                f.write_text(json.dumps(conf_o, ensure_ascii=False, indent=2) + "\n")
    return notes, bad


def cmd_obsidian(a):
    conf = load()
    sdir, reopen = setting_dir(conf), False
    if a.fix and a.restart and obsidian_running():
        # 고칠 것이 있을 때만 끈다. 끌 때 Obsidian이 쓴 목록을 아래에서 다시 읽는다
        if obsidian_vaults(load(), False, a.prune)[1] or obsidian_folders(conf, sdir, False)[1]:
            if not obsidian_quit():
                print("⚠ Obsidian을 끄지 못함 — 직접 끈 뒤 다시")
                return 1
            reopen = True
    notes, bad, conf_changed = obsidian_vaults(conf, a.fix, a.prune)
    n2, b2 = obsidian_folders(conf, sdir, a.fix)
    if reopen:
        n2.append("Obsidian을 껐다가 다시 켬" if obsidian_open() else "Obsidian을 껐음 — 다시 켜지 못함, 직접 켠다")
    if conf_changed:
        save(conf, False)
    for n in notes + n2:
        print(n)
    print("Obsidian 맞음" if not (bad or b2) else "⚠ Obsidian 고칠 것 있음")
    return 1 if bad or b2 else 0


def cmd_install(a):
    src = expand(a.src) if a.src else Path(__file__).resolve().parent.parent
    if not (src / "SKILL.md").exists():
        src = src / "global" / "wiki-vault"
    if not (src / "SKILL.md").exists():
        sys.exit(f"{src}에 wiki-vault 스킬이 없다")
    for d in SKILL_DIRS:
        print(f"{'복사 예정' if a.dry_run else '복사'}: {short(src)} → {short(d)}")
        if not a.dry_run:
            if d.exists():
                shutil.rmtree(d)
            shutil.copytree(src, d)  # 링크가 아니라 복사: 세팅 폴더가 없어져도 스킬은 남는다
            (d / "bin" / "wiki-setting").chmod(0o755)
            ver = src.parent.parent / "VERSION"
            if ver.exists():
                (d / "VERSION").write_text(ver.read_text())
    conf = load()
    if not VAULTS.exists() or a.dry_run:
        conf.setdefault("setting", {"path": short(src.parent.parent if src.name == "wiki-vault" else DEFAULT_SETTING)})
        save(conf, a.dry_run)
    return 0


def cmd_list(a):
    conf = load()
    if not conf.get("vaults"):
        print("등록된 볼트 없음 — wiki-setting register <폴더>")
        return 0
    for vid, v in conf["vaults"].items():
        path = expand(v["path"])
        w = vault_info(v, path)
        mark ="" if path.exists() else "  (폴더 없음 — doctor)"
        ro = " · 읽기 전용" if v.get("readonly") else ""
        print(f"{vid}{' (기본)' if conf.get('default') == vid else ''}: {short(path)}{ro}{mark}")
        if w:
            print(f"  {w.get('name', '')} — {w.get('description', '')} · 별칭 {', '.join(w.get('aliases', []))}")
    return 0


def cmd_path(a):
    v = load().get("vaults", {}).get(a.id)
    if not v:
        sys.exit(f"'{a.id}' 볼트가 없다 — wiki-setting list")
    print(expand(v["path"]))
    return 0


def cmd_register(a):
    path = expand(a.folder)
    w = wiki_info(path)
    vid = a.id or w.get("id")
    if not vid:
        sys.exit(f"{short(path)}에 wiki.toml [wiki] id가 없다 — --id로 정한다")
    conf = load()
    meta = {"name": a.name, "description": a.description, "aliases": a.alias}
    conf.setdefault("vaults", {})[vid] = {"path": short(path), **({"readonly": True} if a.readonly else {}),
                                          **{k: val for k, val in meta.items() if val}}
    conf.setdefault("default", vid if vid == "personal" else conf.get("default", vid))
    save(conf, a.dry_run)
    return 0


def cmd_new_vault(a):
    sdir = setting_dir(load())
    path = expand(a.path)
    r = subprocess.run([PY, str(sdir / "scripts" / "new_wiki.py"), "--profile", a.profile, "--dest", str(path)])
    if r.returncode not in (0, 1):
        return r.returncode
    a.folder, a.id, a.readonly = str(path), None, False
    return cmd_register(a)


def find_moved(vid):
    hits = []
    for root in SEARCH_ROOTS:
        if not root.exists():
            continue
        for f in root.glob("*/wiki.toml"):
            if tomllib.loads(f.read_text()).get("wiki", {}).get("id") == vid:
                hits.append(f.parent)
    return sorted(set(hits))


def cmd_doctor(a):
    conf, bad = load(), 0
    def say(ok, text, fix=""):
        nonlocal bad
        bad += 0 if ok else 1
        print(f"{'✓' if ok else '✗'} {text}" + (f"\n  → {fix}" if fix and not ok else ""))
    for d in SKILL_DIRS:
        say((d / "SKILL.md").exists(), f"전역 스킬 {short(d)}", "wiki-setting install")
    say(VAULTS.exists(), f"볼트 목록 {short(VAULTS)}", "wiki-setting install")
    sdir = setting_dir(conf)
    say((sdir / "VERSION").exists(), f"세팅 사본 {short(sdir)}", "vaults.toml [setting] path를 고친다")
    sver = (sdir / "VERSION").read_text().strip() if (sdir / "VERSION").exists() else "?"
    if (sdir / ".git").exists():
        tag, note = latest_tag(sdir)
        print(f"  세팅 v{sver}" + (f" · 최신 릴리스 {tag}" if tag else "") + (f" · {note}" if note else ""))
    changed, hints = False, {}
    for vid, v in conf.get("vaults", {}).items():
        path = expand(v["path"])
        if not path.exists():
            hits = find_moved(vid)
            if len(hits) == 1 and a.fix:
                hints[vid] = path
                v["path"], path, changed = short(hits[0]), hits[0], True
                print(f"! {vid}: 경로를 {short(hits[0])}로 고침")
            else:
                say(False, f"{vid}: {short(path)} 없음",
                    f"후보 {', '.join(map(short, hits))} — wiki-setting doctor --fix" if len(hits) == 1
                    else (f"후보 여럿: {', '.join(map(short, hits))} — 사람이 고른다" if hits else "wiki-setting register <폴더>"))
                continue
        w = vault_info(v, path)
        say(w.get("id", vid) == vid, f"{vid}: {short(path)} ({w.get('name', '이름 없음')})", "wiki.toml [wiki] id가 목록과 다르다")
        if v.get("readonly"):
            continue
        st = path / ".wiki-setting.toml"
        if st.exists():
            wv = tomllib.loads(st.read_text()).get("version", "?")
            say(wv == sver, f"  세팅 v{wv}", f"wiki-setting upgrade {vid}")
        r = subprocess.run([PY, str(path / "tools" / "check.py"), str(path)], capture_output=True, text=True)
        last = (r.stdout.strip().splitlines() or [r.stderr.strip()])[-1]
        say(r.returncode == 0, f"  점검: {last}", f"{short(path)}에서 '점검해줘'")
    onotes, obad, ochanged = obsidian_vaults(conf, a.fix, hints=hints)  # 옮긴 위키는 Obsidian 볼트도 따라간다
    for n in onotes:
        print(f"  Obsidian: {n}")
    bad += obad
    if changed or ochanged:
        save(conf, False)
    print("문제 없음" if not bad else f"문제 {bad}개")
    return 1 if bad else 0


def cmd_upgrade(a):
    conf = load()
    sdir = setting_dir(conf)
    if (sdir / ".git").exists():
        tag, note = latest_tag(sdir)
        if note:
            print(note)
        if tag:
            head = git("describe", "--tags", "--exact-match", cwd=sdir).stdout.strip()
            if head != tag:
                if git("status", "--porcelain", cwd=sdir).stdout.strip():
                    print(f"세팅 사본에 커밋 안 된 변경이 있어 {tag}로 옮기지 않는다 ({short(sdir)})")
                else:
                    git("checkout", "--quiet", tag, cwd=sdir)
                    print(f"세팅 사본 → {tag}")
    targets = {a.id: conf["vaults"][a.id]} if a.id else conf.get("vaults", {})
    rc = 0
    for vid, v in targets.items():
        if v.get("readonly"):
            continue
        print(f"[{vid}]")
        r = subprocess.run([PY, str(sdir / "scripts" / "upgrade.py"), str(expand(v["path"])), *(["--yes"] if a.yes else [])])
        rc = rc or (r.returncode if r.returncode != 1 else 0)
    return rc


def ensure_setting(conf):
    """세팅 사본을 main의 최신 릴리스 태그로 맞춘다. (세팅 폴더, 버전, 메모 목록, 문제 여부)"""
    s = conf.get("setting", {})
    sdir = setting_dir(conf)
    notes, bad = [], False
    if not sdir.exists() and s.get("repo"):
        r = subprocess.run(["git", "clone", "--quiet", f"https://github.com/{s['repo']}.git", str(sdir)], capture_output=True, text=True)
        notes.append("세팅 사본을 받음" if r.returncode == 0 else f"세팅 사본을 못 받음: {r.stderr.strip()[:80]}")
    if not (sdir / "VERSION").exists():
        return sdir, "?", notes + [f"세팅 사본 없음 ({short(sdir)})"], True
    if (sdir / ".git").exists():
        tag, note = latest_tag(sdir)
        if note:
            notes.append(note)
        if tag:
            head = git("describe", "--tags", "--exact-match", cwd=sdir).stdout.strip()
            if head != tag:
                if git("status", "--porcelain", cwd=sdir).stdout.strip():
                    notes.append(f"세팅 사본에 고친 파일이 있어 {tag}로 옮기지 않음")
                    bad = True
                else:
                    git("checkout", "--quiet", "--detach", tag, cwd=sdir)
                    notes.append(f"세팅 사본 → {tag}")
    return sdir, (sdir / "VERSION").read_text().strip(), notes, bad


def cmd_check(a):
    conf = load()
    sdir, sver, notes, bad = ensure_setting(conf)
    os.environ["YW_SETTING_CHECKED"] = "1"  # 아래 볼트 확인에서 원격을 다시 받지 않는다
    # 전역 스킬이 세팅과 같은 버전인지
    src = sdir / "global" / "wiki-vault"
    for d in SKILL_DIRS:
        have = (d / "VERSION").read_text().strip() if (d / "VERSION").exists() else None
        newer = have and tuple(int(x) for x in re.findall(r"\d+", have)[:3]) > tuple(int(x) for x in re.findall(r"\d+", sver)[:3])
        if src.exists() and have != sver and not newer:
            if d.exists():
                shutil.rmtree(d)
            shutil.copytree(src, d)
            (d / "bin" / "wiki-setting").chmod(0o755)
            (d / "VERSION").write_text(sver + "\n")
            notes.append(f"전역 스킬 {short(d)} v{have or '?'} → v{sver}")
    # 볼트
    if a.vault:
        targets = {"(이 위키)": {"path": a.vault}}
    else:
        targets = {k: v for k, v in conf.get("vaults", {}).items() if not v.get("readonly")}
    for vid, v in targets.items():
        path = expand(v["path"])
        st = path / ".wiki-setting.toml"
        if not st.exists():
            notes.append(f"{vid}: 세팅으로 만든 위키가 아님 ({short(path)})")
            bad = True
            continue
        wv = tomllib.loads(st.read_text()).get("version", "0.0.0")
        vt = lambda v: tuple(int(x) for x in re.findall(r"\d+", v)[:3])
        if vt(wv) > vt(sver):  # 위키가 더 새 버전(세팅 개발 중 시험 등) — 절대 내리지 않는다
            notes.append(f"{vid}: 세팅 v{wv} (세팅 사본 v{sver}보다 새것 — 그대로 둠)")
        elif wv != sver:
            if wv.split(".")[0] != sver.split(".")[0]:
                notes.append(f"{vid}: 세팅 v{wv} → v{sver}는 메이저 변경 — 확인 뒤 wiki-setting upgrade {vid} --yes")
                bad = True
            else:
                clean = not git("status", "--porcelain", cwd=path).stdout.strip()
                r = subprocess.run([PY, str(sdir / "scripts" / "upgrade.py"), str(path)], capture_output=True, text=True)
                if r.returncode == 0 and clean:
                    git("add", "-A", cwd=path)
                    c = git("commit", "-q", "-m", f"세팅 v{wv} → v{sver} 반영 (wiki-setting check)", cwd=path)
                    pushed = ""
                    if c.returncode == 0 and git("remote", cwd=path).stdout.strip() and \
                            git("branch", "--show-current", cwd=path).stdout.strip() == "main":
                        pr = git("push", "-q", "origin", "main", cwd=path)  # 규칙: 끝나면 push (main에서만, force 없음)
                        pushed = " · push" if pr.returncode == 0 else " · push 못 함(원격이 앞섬 — 갱신해줘)"
                        bad |= pr.returncode != 0
                    notes.append(f"{vid}: 세팅 v{wv} → v{sver} 반영" + ("" if c.returncode == 0 else " (커밋 못 함 — 점검 오류)") + pushed)
                    bad |= c.returncode != 0
                else:
                    notes.append(f"{vid}: 세팅 v{wv} → v{sver} 반영" + (" (고친 파일이 있어 커밋은 안 함)" if r.returncode == 0 else " 실패"))
                    bad |= r.returncode != 0
        if not a.vault:  # 볼트마다 main 기준 · 플러그인까지 (볼트의 version.py)
            r = subprocess.run([PY, str(path / "tools" / "version.py"), str(path), "--hook"], capture_output=True, text=True)
            line = (r.stdout.strip().splitlines() or [""])[-1]
            if line:
                notes.append(line)
                bad |= line.split("] ", 1)[-1].startswith("⚠")
    print(("⚠ " if bad else "") + f"세팅 v{sver}" + (" · " + " · ".join(notes) if notes else " · 최신"))
    return 1 if bad else 0


def main():
    p = argparse.ArgumentParser(prog="wiki-setting", description=__doc__.splitlines()[0])
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("install"); s.add_argument("--from", dest="src"); s.add_argument("--dry-run", action="store_true")
    sub.add_parser("list")
    s = sub.add_parser("path"); s.add_argument("id")
    s = sub.add_parser("register"); s.add_argument("folder"); s.add_argument("--id"); s.add_argument("--readonly", action="store_true"); s.add_argument("--dry-run", action="store_true")
    s.add_argument("--name"); s.add_argument("--alias", action="append"); s.add_argument("--description")
    s = sub.add_parser("new-vault"); s.add_argument("--profile", required=True, choices=["personal"]); s.add_argument("--path", required=True); s.add_argument("--dry-run", action="store_true")
    s = sub.add_parser("doctor"); s.add_argument("--fix", action="store_true")
    s = sub.add_parser("upgrade"); s.add_argument("id", nargs="?"); s.add_argument("--yes", action="store_true")
    s = sub.add_parser("check"); s.add_argument("--vault")
    s = sub.add_parser("obsidian"); s.add_argument("--fix", action="store_true"); s.add_argument("--prune", action="store_true"); s.add_argument("--restart", action="store_true")
    a = p.parse_args()
    return {"install": cmd_install, "list": cmd_list, "path": cmd_path, "register": cmd_register,
            "new-vault": cmd_new_vault, "doctor": cmd_doctor, "upgrade": cmd_upgrade, "check": cmd_check,
            "obsidian": cmd_obsidian}[a.cmd](a)


if __name__ == "__main__":
    sys.exit(main())
