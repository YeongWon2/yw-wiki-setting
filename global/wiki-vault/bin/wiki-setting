#!/bin/sh
"true" ; PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
"exec" "yw-wiki" "setting" "$@"
# wiki-setting = yw-wiki setting (Rust CLI). 위 두 줄은 셸에서, 아래는 옛 실행기처럼 python으로 불렸을 때 같은 곳으로 넘긴다.
import os, sys
os.environ["PATH"] = os.path.expanduser("~/.local/bin") + ":" + os.path.expanduser("~/.cargo/bin") + ":" + os.environ.get("PATH", "")
os.execvp("yw-wiki", ["yw-wiki", "setting", *sys.argv[1:]])
